# BusinessOS Environment Configuration Template
# Copy this file to .env or .env.local and configure your values.
# DO NOT commit real secrets to source control.

# Database connection URL
# For local development: file:./dev.db
# For production PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="file:./dev.db"

# Session encryption secret for JWT signing (minimum 32 characters)
# Generate via: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-secure-random-secret-key-at-least-32-chars"

# Application Environment
NODE_ENV="development"

# Demo Environment Indicator (controls UI badge only; does not provide or remove server-side authorization)
# Set to "true" only for deployments intended to display the demo/read-only environment indicator.
NEXT_PUBLIC_DEMO_MODE="false"
